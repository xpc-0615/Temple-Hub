# Copy this file to .env locally. Never commit real tokens or secrets.
PORT=3000
# Public HTTPS URL after hosting, e.g. https://your-templehub.onrender.com
APP_URL=
# From LINE Developers > Messaging API channel > Channel secret / Channel access token
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# From LINE Developers > LIFF > Add LIFF app
LIFF_ID=
